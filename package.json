{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "1.2.1",
  "description": "A Modern POS System",
  "author": "Your Name",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --publish never",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "concurrently \"npm:dev\" \"electron .\"",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:build": "vite build && electron-builder --publish never",
    "release": "vite build && electron-builder --publish always",
    "postinstall": "node scripts/rebuild-native.cjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "chart.js": "^4.5.0",
    "crc": "^4.3.2",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.6.2",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.503.0",
    "pdfmake": "^0.2.19",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-day-picker": "^9.11.0",
    "react-dom": "^18.3.1",
    "react-rnd": "^10.5.2",
    "react-router-dom": "^6.22.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/bcrypt": "^6.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.0.6"
  },
  "build": {
    "appId": "com.pos.app",
    "productName": "POS System",
    "directories": {
      "output": "dist_electron",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bcrypt/**"
    ],
    "compression": "normal",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "lottelotte2000",
      "repo": "Pos",
      "releaseType": "draft"
    }
  }
}
